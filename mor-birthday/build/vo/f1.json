[{"text": "מור שבת!", "start": 0.1, "end": 1.9325243}, {"text": "האיש.", "start": 1.8825243, "end": 3.4601942}, {"text": "האגדה.", "start": 3.4601942, "end": 5.0621359}, {"text": "האחראי על הציוד.", "start": 5.062136, "end": 7.1609224}, {"text": "אבל יותר מהכול – אדם מיוחד, שמגיע לו כל הטוב שבעולם!", "start": 7.1609225, "end": 12.2944177}]